{
  "name": "wholelinecompletion",
  "displayName": "wholeLineCompletion",
  "description": "This extension shows whole line suggestions based on the current word",
  "version": "0.0.2",
  "icon": "images/icon.jpeg",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuan/wholelinecompletion.git"
  },
  "publisher": "tuannguyen",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wholelinecompletion.triggerSuggest",
        "title": "Trigger Whole Line Completion"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "vscode:package": "vsce package --no-dependencies",
    "vscode:publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2",
    "vsce": "^2.15.0"
  }
}
